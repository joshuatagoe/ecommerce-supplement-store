{
  "name": "ecommerce-supplement-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/setup.ts",
    "verify": "node scripts/verify.ts",
    "push": "node scripts/push.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:skills": "node scripts/check-skills.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
