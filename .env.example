# Local development only. `npm run setup` copies this to .env.
# Real secrets go in Render's environment settings, never in this file.
DATABASE_URL=postgres://store:store@localhost:5433/store
TEST_DATABASE_URL=postgres://store:store@localhost:5434/store_test
# Signs provider sessions (D32). This value is for local use only; Render has its own.
JWT_SECRET=local-only-secret-change-me-0123456789abcdef
